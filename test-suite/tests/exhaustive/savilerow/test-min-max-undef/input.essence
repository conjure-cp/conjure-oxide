language ESSENCE' 1.0

find x : matrix indexed by [int(1..6)] of int(1..10)

such that

$ Keep the original matrix shape and domain, with exactly four complete solutions.
x[1] <= 2,
x[2] <= 2,
(forAll i : int(3..6) . x[i] = 1),

! (max([] :: matrix indexed by [int] of int)=0),

! (min([] :: matrix indexed by [int] of int)=0),

! (min([] :: matrix indexed by [int] of int)=10),

! (min([x[i] | i : int(1..6), i<1])=0),

true
