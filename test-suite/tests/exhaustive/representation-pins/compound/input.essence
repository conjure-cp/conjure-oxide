language Essence 1.3

find t : tuple (representation components, int(1..3), bool)
find r : record (representation packed) {x: int(1..3), y: bool}
find m : matrix (representation components) indexed by [int(1..2)] of int(representation direct, 1..3)

such that t[1] < r[x], t[2] -> r[y], m[1] + m[2] = t[1] + 2
