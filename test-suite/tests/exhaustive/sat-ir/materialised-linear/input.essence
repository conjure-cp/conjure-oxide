language Essence 1.3
find x : int(-2,-1,1,2)
find y : int(-1..1)
find productValue : int(-9..9)
find quotientValue : int(-9..9)
find absoluteValue : int(0..3)
find minimumValue, maximumValue : int(-5..5)
find caughtValue : int(-9..9)
such that
  productValue = (x + y) * (x - y),
  quotientValue = (2*x - 3*y + 1) / x,
  absoluteValue = |-x + y|,
  minimumValue = min([2*x + y, x - y]),
  maximumValue = max([2*x + y, x - y]),
  caughtValue = catchUndef((2*x + y) / (x + y), 0)
