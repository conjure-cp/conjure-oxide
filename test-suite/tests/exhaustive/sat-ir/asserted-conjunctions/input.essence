language Essence 1.3
find a,b,c,p : bool
find y : int(0..3)
such that
    and([
        sum([toInt(a),toInt(b),toInt(c)]) >= 1,
        and([
            sum([toInt(a),toInt(b),toInt(c)]) <= 2,
            2 * toInt(a) + 3 * toInt(b) + toInt(c) <= 4
        ])
    ]),
    y = sum([toInt(a),toInt(b),toInt(c)]),
    (y <= 1) <-> p
