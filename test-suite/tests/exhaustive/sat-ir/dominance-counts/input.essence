language Essence 1.3

find a1, a2, a3 : bool
find b1, b2, b3 : bool
find small_a : bool

such that
    sum([toInt(a1), toInt(a2), toInt(a3)]) +
    sum([toInt(b1), toInt(b2), toInt(b3)]) >= 3,
    small_a <-> sum([toInt(a1), toInt(a2), toInt(a3)]) <= 1

dominance relation
    pareto(minimising sum([toInt(a1), toInt(a2), toInt(a3)]),
           minimising sum([toInt(b1), toInt(b2), toInt(b3)]))
