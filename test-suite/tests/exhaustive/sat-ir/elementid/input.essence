language ESSENCE' 1.0
find i : int(-3, -2, 3, 4)
find j : int(0..4)
find m : matrix indexed by [int(-2, 3)] of int(10, 20)
find y : int(-3, 4, 10, 20)
find r : bool
find b : int(0..4)
such that
    y = elementId(m, i),
    r = (elementId([3,1,2], j) = 3),
    b = elementId([toInt(false),toInt(true)], j),
    elementId([10,20;int(-2,3)], -2) = 10
