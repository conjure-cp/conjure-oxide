language Essence 1.3
find x, y, exception : set (maxSize 2) of int(-2,3)
find ordinary, allowed, repeated, negative, fixed : bool
such that
  alldifferent_except([x,y,{-2}], exception),
  ordinary <-> allDiff([x,y]),
  allowed <-> alldifferent_except([x,y], exception),
  repeated <-> alldifferent_except([x,x,y], exception),
  negative <-> !allDiff([x,y]),
  fixed <-> alldifferent_except([x,y], {-2}),
  alldifferent_except([x,y], exception) \/ !allDiff([x,y])
