language Essence 1.3
find x : int(-3,-2,0,3)
find b, c, zero, at_most_two : bool
find mixed, quotient : int(-3..3)
find remainder : int(0..1)
such that
  mixed = x * toInt(b),
  zero <-> x * toInt(b) = 0,
  x * toInt(b /\ x != 0) = mixed,
  quotient = x / (toInt(b) + 1),
  remainder = x % (toInt(b) + 1),
  at_most_two <-> sum([toInt(b), toInt(c), toInt(x % 2 != 0), toInt(x != 0)]) <= 2
