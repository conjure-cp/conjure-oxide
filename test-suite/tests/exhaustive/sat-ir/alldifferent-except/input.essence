language Essence 1.3
find x, y, z : int(-2,0,3)
find allowed, ordinary, repeated, negative : bool
such that
  alldifferent_except([x,y,0], 0),
  allowed <-> alldifferent_except([x,y,z], 0),
  ordinary <-> alldifferent_except([x,y,z], 42),
  repeated <-> alldifferent_except([x,x,y], 0),
  negative <-> !alldifferent_except([x,y,-2], 3)
