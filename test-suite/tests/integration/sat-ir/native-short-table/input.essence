find x,y : int(-1..1)
find match, impossible, universal, empty : bool
such that
    match <-> shortTable(sequence(x,y), {{(1,y)}, {(2,-1)}}),
    impossible <-> shortTable(sequence(x,x), {{(1,-1),(2,1)}}),
    universal <-> shortTable(sequence(x,y), {{}}),
    empty <-> shortTable(sequence(x,y), {})
