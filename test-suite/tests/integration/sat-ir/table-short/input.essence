language Essence 1.3
find x,y,z : int(-2,0,3)
find positive,negative,empty,universal : bool
such that
 positive <-> shortTable(sequence(x,y,z), {{(1,-2),(3,z)},{(2,3)}}),
 negative <-> !shortTable(sequence(x,y,z), {{(1,x),(2,0)}}),
 empty <-> shortTable(sequence(x,y,z), {}),
 universal <-> shortTable(sequence(x,y,z), {{}})
