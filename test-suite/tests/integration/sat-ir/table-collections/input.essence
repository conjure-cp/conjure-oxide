find x, y : int(1..3)
such that
    table(sequence(x,y), {sequence(1,2), sequence(2,1), sequence(3,3)}),
    negativeTable(sequence(x,y), {sequence(3,3)}),
    shortTable(sequence(x,y), {{(1,1)}, {(2,1)}}),
    !table(sequence(x), {}),
    negativeTable(sequence(x), {}),
    shortTable(sequence(x), {{}}),
    !shortTable(sequence(x), {})
