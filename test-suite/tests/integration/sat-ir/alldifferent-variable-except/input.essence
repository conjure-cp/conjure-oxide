language Essence 1.3
find x, y, z : int(-2,0,3)
find exception : int(-2,0,3,42)
find allowed, repeated, negative : bool
such that
  alldifferent_except([x,y,0], exception),
  allowed <-> alldifferent_except([x,y,z], exception),
  repeated <-> alldifferent_except([x,x,y], exception),
  negative <-> !alldifferent_except([x,y,-2], exception),
  alldifferent_except([x,y,z], exception) \/ (x = y)
