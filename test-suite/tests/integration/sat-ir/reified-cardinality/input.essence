language Essence 1.3

find a, b, c, d, e, f : bool
find amo, le, lt, eq, ne, ge, gt, reversed, duplicate : bool
such that
    (sum([toInt(a), toInt(b), toInt(c), toInt(d), toInt(e), toInt(f)]) <= 1) <-> amo,
    (sum([toInt(a), toInt(b), toInt(c), toInt(d), toInt(e), toInt(f)]) <= 2) <-> le,
    (sum([toInt(a), toInt(b), toInt(c), toInt(d), toInt(e), toInt(f)]) < 2) <-> lt,
    (sum([toInt(a), toInt(b), toInt(c), toInt(d), toInt(e), toInt(f)]) = 2) <-> eq,
    (sum([toInt(a), toInt(b), toInt(c), toInt(d), toInt(e), toInt(f)]) != 2) <-> ne,
    (sum([toInt(a), toInt(b), toInt(c), toInt(d), toInt(e), toInt(f)]) >= 2) <-> ge,
    (sum([toInt(a), toInt(b), toInt(c), toInt(d), toInt(e), toInt(f)]) > 2) <-> gt,
    (2 >= sum([toInt(a), toInt(b), toInt(c), toInt(d), toInt(e), toInt(f)])) <-> reversed,
    (sum([toInt(a), toInt(a), toInt(!b), 1, 0]) = 2) <-> duplicate
