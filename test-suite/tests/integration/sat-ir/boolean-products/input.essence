language Essence 1.3
find a, b, zero : bool
find p : int(0..1)
find weighted : int(-1..2)
such that
  p = toInt(a) * toInt(b),
  weighted = 2 * (toInt(a) * toInt(b)) - toInt(a),
  zero <-> toInt(a) * toInt(b) = 0,
  toInt(a) * toInt(b) * toInt(b) = p,
  toInt(a) * toInt(!b) + toInt(a) * toInt(b) = toInt(a)
