find a,b : bool
find lt, le, gt, ge, eq, ne, repeated, signed : bool
such that
    lt = ((1073741823*toInt(a) + 1073741824*toInt(b)) < 1073741824),
    le = ((1073741823*toInt(a) + 1073741824*toInt(b)) <= 1073741824),
    gt = ((1073741823*toInt(a) + 1073741824*toInt(b)) > 1073741824),
    ge = ((1073741823*toInt(a) + 1073741824*toInt(b)) >= 1073741824),
    eq = ((1073741823*toInt(a) + 1073741824*toInt(b)) = 1073741824),
    ne = ((1073741823*toInt(a) + 1073741824*toInt(b)) != 1073741824),
    repeated = (536870912*toInt(a) + 536870912*toInt(b) <= 536870912),
    signed = (-1073741823*toInt(a) + 1073741824*toInt(b) >= 1)
