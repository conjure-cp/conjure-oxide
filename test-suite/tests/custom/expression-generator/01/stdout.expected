find x#explicit_1#components_8: int(1..10)
find x#explicit_1#components_9: int(1..10)
find x#explicit_1#components_10: int(1..10)

such that

sum([ i | i <- x ]) = 2,
or([Ineq(x#explicit_2, 1, 0),FlatLexLt([x#explicit_1#components_1], [x#explicit_1#components_2]);int(1..)]),
