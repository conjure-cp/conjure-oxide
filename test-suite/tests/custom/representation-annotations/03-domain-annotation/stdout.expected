find x: set{occurrence} (maxSize 2) of int(1..4)
find x#occurrence_1: bool
find x#occurrence_2: bool
find x#occurrence_3: bool
find x#occurrence_4: bool

such that

x#occurrence_1,
SumGeq([x#occurrence_1, x#occurrence_2, x#occurrence_3, x#occurrence_4], 0),
SumLeq([x#occurrence_1, x#occurrence_2, x#occurrence_3, x#occurrence_4], 2)

