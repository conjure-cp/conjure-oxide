given k : int(1..3)
given n : int(4..6)
find p : partition (numParts k) from int(1..n)
find bounded : partition (minNumParts k, maxNumParts k + 1, minPartSize 1, maxPartSize n - 1) from int(1..n)
find regularPartition : partition (partSize k, regular) from int(1..n)
find f : function (minSize k, maxSize k + 1) int(1..n) --> int(1..n)
find r : relation (size k + 1) of (int(1..n) * int(1..n))
find perm : permutation (minNumMoved k, maxNumMoved k + 1) of int(1..n)
